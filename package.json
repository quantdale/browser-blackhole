{
  "name": "browser-blackhole",
  "version": "0.1.0",
  "private": true,
  "description": "Interactive relativistic black-hole renderer in the browser (Three.js WebGPU/TSL).",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "test:browser": "npm run e2e",
    "lut:generate": "tsx tools/generate-luts/generate.ts",
    "lut:validate": "tsx tools/generate-luts/validate.ts",
    "lut:study": "tsx tools/generate-luts/study.ts",
    "bench:black-hole": "node scripts/bench-black-hole.mjs",
    "bench:black-hole:numerical": "node scripts/bench-black-hole.mjs --backend=numerical --label=numerical",
    "bench:black-hole:lut": "node scripts/bench-black-hole.mjs --backend=lut --label=lut",
    "bench:compact-merger": "node scripts/bench-compact-merger.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "three": "0.185.1"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@types/node": "22.20.1",
    "@types/three": "0.185.4",
    "eslint": "10.8.1",
    "prettier": "3.9.6",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "typescript-eslint": "8.67.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
